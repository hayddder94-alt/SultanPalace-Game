# Unreal binary assets — enable Git LFS on the production machine before the first .uasset commit.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.abc filter=lfs diff=lfs merge=lfs -text
*.otf filter=lfs diff=lfs merge=lfs -text

# Concept art is small, few, and needed by everyone who clones. Routing it
# through LFS would mean a clone without git-lfs installed gets 130-byte
# pointer files where the reference sheets should be - so it stays ordinary
# binary, like the font.
docs/art/**/*.png -filter -diff -merge binary

# HUD Arabic font is stored as a regular binary (no LFS required).
Content/TBW/UI/Fonts/*.ttf -filter -diff -merge binary

# Keep text as text
*.md text
*.ini text
*.cs text
*.cpp text
*.h text
*.uproject text
*.uplugin text
*.json text
