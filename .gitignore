# OS
.DS_Store
Thumbs.db
desktop.ini

# Per-user editor. The copy the editor writes under Saved/ is per-machine and
# stays out. Config/DefaultEditorPerProjectUserSettings.ini is the opposite: it
# is the project-wide default every clone needs - notably
# bMonitorContentDirectories=False, without which the editor offers to import
# our runtime JSON as DataTables.
*EditorPerProjectUserSettings.ini
!Config/DefaultEditorPerProjectUserSettings.ini

# Visual Studio's per-machine component list. Written by the editor the first
# time it offers to install a missing workload. Says nothing about the game.
.vsconfig

# Maps the editor creates at the Content root when you press File > New Level
# and save without choosing a folder. The project has exactly one map and it
# lives under Content/TBW/Maps. Anything here is a stray.
/Content/*.umap
/Content/*.uasset

# Third-party art packs: acquired per machine from your Fab library, never committed.
# A single Megascans pack can exceed the size of this entire repository.
# Engine template content, copied per machine by tools/ADD_CHARACTERS.cmd
Content/Characters/

Content/Megascans/
Content/MSPresets/
Content/MetaHumans/
Content/Fab/
Content/Marketplace/
Content/StarterContent/

# Python bytecode from the offline validators
__pycache__/
*.pyc

# Generated art. tools/BUILD_LEVEL.cmd creates the blockout master material and
# its five instances under Content/TBW/Art/Blockout; the colour table in
# tools/ue_python/build_east_wing.py is the source of truth, not the .uasset.
# Content/TBW/Art/Imported is where a downloaded Megascans/Fab pack goes - never
# committed, because a pack acquired under one account cannot ship from another.
Content/TBW/Art/

# Generated level. Rebuilt deterministically from web/preview/data/east_wing.json
# by tools/BUILD_LEVEL.cmd, so the data is the source of truth, not the binary.
# Delete this rule the day the level becomes hand-authored.
Content/TBW/Maps/*.umap
Content/TBW/Maps/*.uasset
