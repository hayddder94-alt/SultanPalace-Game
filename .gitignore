# Third-party art packs: acquired per machine from your Fab library, never committed.
# A single Megascans pack can exceed the size of this entire repository.
# Engine template content, copied per machine by tools/ADD_CHARACTERS.cmd
Content/Characters/

Content/Megascans/
Content/MSPresets/
Content/MetaHumans/
Content/Fab/
Content/Marketplace/
Content/StarterContent/

# Python bytecode from the offline validators
__pycache__/
*.pyc

# Generated level. Rebuilt deterministically from web/preview/data/east_wing.json
# by tools/BUILD_LEVEL.cmd, so the data is the source of truth, not the binary.
# Delete this rule the day the level becomes hand-authored.
Content/TBW/Maps/*.umap
Content/TBW/Maps/*.uasset
