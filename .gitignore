# Local / agent
build/
build.log
.arena/
.vscode/
.idea/
*.log

# Unreal Engine
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
FileOpenOrder/
.vs/
*.sln
*.slnx
*.uba
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.xcodeproj
